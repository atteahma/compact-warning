#!/usr/bin/env bash
# Checks the mod against the installed Claude Code: the manifest, the types
# and the tests. It needs no login, so CI runs it too.
#
# On a Claude Code older than the mod's floor it checks the manifest only: the
# mod turns itself off there, and that version's test kit differs.
# Usage: tools/check
set -euo pipefail

cd "$(dirname "$0")/.."

readonly MANIFEST=.claude-plugin/plugin.json
readonly LOGIC=hooks/logic.ts

# True when version $1 is older than version $2.
older() {
  [[ "$1" != "$2" && "$(printf '%s\n%s\n' "$1" "$2" | sort -V | head -1)" == "$1" ]]
}

version="$(claude --version | awk '{print $1}')"
floor="$(sed -n 's/.*"claude-code": *">=\([0-9.]*\)".*/\1/p' "${MANIFEST}")"
floor_in_code="$(sed -n "s/^export const MIN_VERSION = '\([0-9.]*\)'.*/\1/p" "${LOGIC}")"
echo "== Claude Code ${version}; the mod's floor is ${floor}"

if [[ -z "${floor}" || "${floor}" != "${floor_in_code}" ]]; then
  echo "== failed: ${MANIFEST} names the floor '${floor}', and ${LOGIC} names '${floor_in_code}'"
  exit 1
fi

if older "${version}" "${floor}"; then
  echo "== validate, the manifest only"
  claude plugin validate . | tail -1
  echo "== passed: this Claude Code is older than the floor, so the tests did not run"
  exit 0
fi

echo "== validate, with the type check"
if ! report="$(claude plugin validate --strict . 2>&1)"; then
  printf '%s\n' "${report}"
  exit 1
fi
printf '%s\n' "${report}" | tail -1

echo "== test"
claude plugin test .

echo "== passed on Claude Code ${version}"
